# =============================================================================
# StudyMate frontend environment variables
#
# Copy this file to .env.local and fill in the values for your environment.
# .env.local is git-ignored and should never be committed.
#
# SECURITY — NEVER put these in VITE_* variables:
#   • Groq API keys or any LLM provider credentials
#   • Database connection strings
#   • JWT secrets or signing keys
#   • Any backend-only token or password
#
# VITE_* variables are embedded in the browser bundle and are visible to
# anyone who downloads the app. Only the public API origin belongs here.
# =============================================================================


# -----------------------------------------------------------------------------
# API base URL
#
# The origin of the FastAPI backend.
#   • Local development (without proxy): http://localhost:8000
#   • Local development (with Vite proxy): leave empty — the Vite dev server
#     forwards /api/* to localhost:8000 automatically, which also avoids
#     CORS configuration on the backend.
#   • Production: https://api.yourdomain.com  (no trailing slash)
#
# Required in production when any VITE_*_DATA_MODE is set to "api".
# In development it is optional if the Vite proxy is sufficient.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=


# -----------------------------------------------------------------------------
# Global data mode
#
# Controls which service implementation the app uses by default.
#   mock  — all data is served from in-browser mock services (no backend needed)
#   api   — all features call the FastAPI backend
#
# Use "mock" while building the UI or running without a backend.
# Switch to "api" (or use per-feature overrides below) to connect to FastAPI.
# -----------------------------------------------------------------------------
VITE_DATA_MODE=mock


# -----------------------------------------------------------------------------
# Per-feature data mode overrides
#
# Override the global VITE_DATA_MODE for a single feature.
# Useful for progressively migrating features from mock to api.
#
# Valid values: mock | api
# Unset or empty means the feature inherits VITE_DATA_MODE.
# -----------------------------------------------------------------------------
# VITE_AUTH_DATA_MODE=api
# VITE_PROFILE_DATA_MODE=api
# VITE_COURSES_DATA_MODE=api
# VITE_DOCUMENTS_DATA_MODE=api
# VITE_STUDY_SESSIONS_DATA_MODE=api
# VITE_PROGRESS_DATA_MODE=api
# VITE_ROADMAPS_DATA_MODE=api
# VITE_EXAMS_DATA_MODE=api
# VITE_DASHBOARD_DATA_MODE=api
# VITE_CHAT_DATA_MODE=api
# VITE_STUDY_TOOLS_DATA_MODE=api
