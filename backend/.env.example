# Copy to backend/.env and adjust. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://studymate:studymate@localhost:5433/studymate

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# Local LLM (Ollama runs on the host)
OLLAMA_BASE_URL=http://localhost:11434
LLM_FAST_MODEL=llama3.1:8b
LLM_QUALITY_MODEL=llama3.1:8b
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=10m

# Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# RAG
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.83

# Limits
SESSION_MAX_MODEL_CALLS=20
EXAM_MAX_QUESTIONS=30
EXAM_MAX_MINUTES=180
ROADMAP_MAX_NODES=30
